# Leave these blank to run the shop locally. Orders, inquiries, and edits
# are stored in data/store.json, and the house book signs in with the demo account.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Letters. Verify the domain in Resend, then set both.
RESEND_API_KEY=
EMAIL_FROM=CrownHomeLinen <hello@your-domain.com>

# Required in production if you are not using Supabase yet.
DEMO_ADMIN_EMAIL=admin@crownhomelinen.com
DEMO_ADMIN_PASSWORD=
SESSION_SECRET=

# Optional. The measurement ID can also be pasted in House settings.
# Visits are stored in the house book either way.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
